# Digital Asset Protection - Environment Variables Example

# ==================== ALLOWED ORIGINS ====================
ALLOWED_ORIGINS=http://localhost:5173

# ==================== SCRAPER CONFIGURATION ====================
# Which scrapers to enable (currently "youtube" only for MVP)
ENABLED_SCRAPERS=youtube

# ==================== EMAIL SERVICE CONFIGURATION ====================
# Choose email service: "smtp" or "sendgrid"
EMAIL_SERVICE=smtp

# SMTP Configuration (for Gmail, Outlook, etc.)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password  # For Gmail, use App Password, not account password

# SendGrid Configuration (alternative to SMTP)
# Uncomment if using SendGrid instead of SMTP
# SENDGRID_API_KEY=your-sendgrid-api-key

# ==================== YOUTUBE SEARCH CONTEXT DEFAULTS ====================
# These can be overridden per request in the API

# Sports types
SPORT_TYPE=cricket
LEAGUE_TYPE=IPL

# Duration range in seconds (for filtering results)
DURATION_MIN=120        # 2 minutes
DURATION_MAX=1200       # 20 minutes

# Minimum view count (to skip low-engagement videos)
MIN_VIEW_COUNT=1000

# Maximum days in the past to search (0 = all time)
MAX_DAYS_OLD=30

# ==================== FIREBASE CONFIGURATION ====================
# Path to Firebase service account JSON (download from Firebase Console)
FIREBASE_CREDENTIALS=./firebase-service-account.json

# ==================== QDRANT CONFIGURATION ====================
# Qdrant Cloud vector database URL and API key
QDRANT_URL=https://your-qdrant-cluster-url:6333
QDRANT_API_KEY=your-qdrant-api-key

# ==================== GOOGLE CLOUD CONFIGURATION ====================
# Google Cloud AI/Vision API (set via GOOGLE_APPLICATION_CREDENTIALS env var)
# The firebase-service-account.json above also works for this
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ==================== DEVELOPMENT ====================
DEBUG=true
LOG_LEVEL=INFO
